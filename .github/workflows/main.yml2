name: Build iosu IPA

on:
  workflow_dispatch:

jobs:
  build:
    runs-on: macos-latest
    steps:
      - uses: actions/checkout@v4
        with:
          submodules: recursive

      - name: Patch BGVideoPlayer.swift (VLCAudio is optional in new MobileVLCKit)
        run: |
          perl -pi -e 's/mplayer\.audio\.isMuted/mplayer.audio?.isMuted/' iosu/MediaPlayers/BGVideoPlayer.swift
          grep -n "isMuted" iosu/MediaPlayers/BGVideoPlayer.swift

      - name: Install pods
        run: |
          pod repo update
          pod install

      - name: Build (unsigned)
        run: |
          set -o pipefail
          xcodebuild -workspace iosu.xcworkspace \
            -scheme iosu \
            -configuration Release \
            -sdk iphoneos \
            -destination 'generic/platform=iOS' \
            -derivedDataPath build \
            IPHONEOS_DEPLOYMENT_TARGET=12.0 \
            CODE_SIGNING_ALLOWED=NO \
            CODE_SIGNING_REQUIRED=NO \
            CODE_SIGN_IDENTITY="" \
            2>&1 | tee build.log

      - name: Show errors
        if: failure()
        run: grep -E "error:|fatal error|BUILD FAILED" build.log | head -50 || true

      - name: Package IPA
        run: |
          mkdir -p Payload
          cp -r build/Build/Products/Release-iphoneos/iosu.app Payload/
          zip -r iosu.ipa Payload

      - uses: actions/upload-artifact@v4
        with:
          name: iosu-ipa
          path: iosu.ipa
